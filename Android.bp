soong_config_module_type {
    name: "qssi_vs_vendor_cc_base",
    module_type: "cc_defaults",
    config_namespace: "qssi_vs_vendor",
    variables: ["qssi_or_vendor"],
    properties: ["header_libs",
                 "cflags",
                 "ldflags",
                 "srcs",
                 "shared_libs",
                 "static_libs"
                ],
}

soong_config_string_variable {
    name: "qssi_or_vendor",
    values: ["qssi", "vendor"],
}

soong_config_module_type {
    name: "is_wearable_target_java_defaults",
    module_type: "java_defaults",
    config_namespace: "qtiwearable",
    bool_variables: ["is_wearable_target"],
    properties: ["libs"],
}

soong_config_bool_variable {
     name: "is_wearable_target",
}

